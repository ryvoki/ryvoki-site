{
  "name": "ryvoki-site",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler pages dev public --port 8788",
    "db:local": "wrangler d1 execute ryvoki-db --local --file=./schema.sql",
    "db:remote": "wrangler d1 execute ryvoki-db --remote --file=./schema.sql",
    "keys": "node scripts/gen-signing-key.mjs",
    "deploy": "wrangler pages deploy public"
  },
  "devDependencies": {
    "wrangler": "^4.131.1"
  }
}
