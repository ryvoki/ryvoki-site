# Copy this file to .dev.vars for local development. NEVER commit .dev.vars.
# Production values go in the Cloudflare dashboard -> your Pages project -> Settings -> Environment variables.

# From NOWPayments dashboard -> Store settings -> API keys
NOWPAYMENTS_API_KEY=your-nowpayments-api-key
# From NOWPayments dashboard -> Store settings -> IPN secret
NOWPAYMENTS_IPN_SECRET=your-ipn-secret

# Long random string you make up. Lets you issue keys manually (giveaways, refunds, direct payments).
ADMIN_TOKEN=change-me-to-a-long-random-string

# Generated by:  npm run keys   (paste the PRIVATE key JSON here; the PUBLIC key goes in the desktop app)
LICENSE_SIGNING_KEY={"kty":"EC","crv":"P-256","x":"...","y":"...","d":"..."}
